{
  "name": "sales-order-erp-sample",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React TypeScript mock ERP sales order registration sample.",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:mock": "node scripts/run-mode.mjs dev mock",
    "dev:api:inmemory": "node scripts/run-mode.mjs dev inmemory",
    "dev:api:sqlserver": "node scripts/run-mode.mjs dev sqlserver",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "pnpm run typecheck && vite build",
    "check:bundle-budget": "node scripts/performance/check-bundle-budget.mjs",
    "build:budget": "pnpm run build && pnpm run check:bundle-budget",
    "test:bundle-budget": "node --test scripts/performance/tests/check-bundle-budget.test.mjs",
    "test:grid-view-preferences": "node --experimental-strip-types --test tests/unit/grid-view-preferences.test.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:e2e:mock": "node scripts/run-mode.mjs test mock",
    "test:e2e:api:inmemory": "node scripts/run-mode.mjs test inmemory",
    "test:e2e:api:sqlserver": "node scripts/run-mode.mjs test sqlserver",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:ai-file-intelligence": "node --experimental-strip-types --test tests/unit/ai-file-intelligence.test.ts",
    "qa:maintenance:test": "node --test scripts/qa/tests/*.test.mjs",
    "qa:maintenance:scan": "node scripts/qa/collect-maintenance-signals.mjs",
    "qa:maintenance:report": "node scripts/qa/build-maintenance-report.mjs",
    "qa:quality:quick": "node scripts/qa/run-quality-gates.mjs quick",
    "qa:sql:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-local-sql.ps1",
    "qa:sql:worker:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-local-sql-verify-worker.ps1",
    "qa:sql:worker:install:validate": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-local-sql-verify-worker.ps1 -ValidateOnly",
    "qa:sql:worker:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-sql-verify-worker.ps1",
    "qa:sql:worker:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/get-local-sql-verify-worker-status.ps1",
    "qa:sql:worker:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local-sql-verify-worker.ps1",
    "qa:sql:worker:uninstall": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-local-sql-verify-worker.ps1",
    "qa:sql:request": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/request-local-sql-verify.ps1 -Reason \"manual SQL verification\" -Wait"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  }
}
